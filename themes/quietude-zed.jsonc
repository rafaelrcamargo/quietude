{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "author": "rafaelrcamargo",
  "name": "quietude",
  "themes": [
    {
      "appearance": "dark",
      "name": "quietude",
      "style": {
        "background": "#1a1a1ff0",
        "background.appearance": "blurred",
        "accents": [
          "#bab39c50",
          "#bab39c50",
          "#bab39c50",
          "#bab39c50",
          "#bab39c50",
          "#bab39c50"
        ],
        "elevated_surface.background": "#16161af0",
        "surface.background": "#1a1a1f00",
        "text": "#bab39c",
        "text.accent": "#6c765c",
        "text.disabled": "#64534899",
        "text.muted": "#bab39c99",
        "text.placeholder": "#bab39c33",
        "icon": "#a79879",
        "icon.accent": "#6c765c",
        "icon.disabled": "#64534899",
        "icon.muted": "#a7987990",
        "icon.placeholder": "#a7987990",
        "debugger.accent": "#c15e55",
        "hidden": "#64534899",

        "border": "#bab39c10",
        "border.disabled": "#bab39c10",
        "border.focused": "#b7b7b020",
        "border.selected": "#bab39c20",
        "border.transparent": "#00000000",
        "border.variant": "#bab39c10",

        "element.background": "#1a1a1ff0",
        "element.active": "#454a56",
        "element.hover": "#292929",
        "element.selected": "#454a56",
        "element.selection_background": "#deb17840",
        "element.disabled": "#2e2d33",
        "ghost_element.background": "#00000000",
        "ghost_element.active": "#454a56",
        "ghost_element.hover": "#292929",
        "ghost_element.selected": "#bab39c10",
        "ghost_element.disabled": "#bab39c08",
        "drop_target.background": "#6578a620",
        "drop_target.border": "#6578a680",

        "error": "#c15e55",
        "error.background": "#c15e5515",
        "error.border": "#c15e5599",
        "success": "#6c765c",
        "success.background": "#6c765c1a",
        "success.border": "#6c765c",
        "warning": "#ca9e66",
        "warning.background": "#ca9e6615",
        "warning.border": "#ca9e6699",
        "info": "#6578a6",
        "info.background": "#6578a61a",
        "info.border": "#6578a699",
        "hint": "#6c765c99",
        "hint.background": "#6c765c1a",
        "hint.border": "#6c765c99",
        "predictive": "#565552",
        "predictive.background": "#5655521a",
        "predictive.border": "#bab39c10",

        "created": "#6c765c",
        "created.background": "#6c765c15",
        "created.border": "#6c765c4d",
        "deleted": "#c15e55",
        "deleted.background": "#c15e5515",
        "deleted.border": "#c15e554d",
        "modified": "#ca9e66",
        "modified.background": "#ca9e6615",
        "modified.border": "#ca9e664d",
        "renamed": "#6578a6",
        "renamed.background": "#6578a61a",
        "renamed.border": "#6578a680",
        "conflict": "#ca9e66",
        "conflict.background": "#ca9e6620",
        "conflict.border": "#ca9e6680",
        "ignored": "#bab39c50",
        "ignored.background": "#bab39c08",
        "ignored.border": "#bab39c10",
        "hidden.background": "#bab39c08",
        "hidden.border": "#bab39c10",
        "unreachable": "#565552",
        "unreachable.background": "#00000000",
        "unreachable.border": "#bab39c10",

        "version_control.added": "#6c765c",
        "version_control.deleted": "#c15e55",
        "version_control.modified": "#ca9e66",
        "version_control.renamed": "#6578a6",
        "version_control.conflict": "#ca9e66",
        "version_control.ignored": "#bab39c50",
        "version_control.word_added": "#6c765c40",
        "version_control.word_deleted": "#c15e5538",
        "version_control.conflict_marker.ours": "#6c765c1a",
        "version_control.conflict_marker.theirs": "#6578a61a",

        "editor.background": "#1a1a1f00",
        "editor.foreground": "#bab39c",
        "editor.gutter.background": "#1a1a1f00",
        "editor.subheader.background": "#1a1a1ff0",
        "editor.active_line.background": "#bab39c10",
        "editor.highlighted_line.background": "#bab39c0d",
        "editor.debugger_active_line.background": "#ca9e6620",
        "editor.line_number": "#bab39c30",
        "editor.active_line_number": "#ca9e66",
        "editor.hover_line_number": "#bab39c80",
        "editor.invisible": "#64534899",
        "editor.wrap_guide": "#bab39c15",
        "editor.active_wrap_guide": "#bab39c20",
        "editor.indent_guide": "#bab39c10",
        "editor.indent_guide_active": "#bab39c20",
        "editor.document_highlight.read_background": "#6578a61a",
        "editor.document_highlight.write_background": "#555a6366",
        "editor.document_highlight.bracket_background": "#bab39c40",
        "editor.diff_hunk.added.background": "#6c765c18",
        "editor.diff_hunk.added.hollow_background": "#6c765c10",
        "editor.diff_hunk.added.hollow_border": "#6c765c4d",
        "editor.diff_hunk.deleted.background": "#c15e5518",
        "editor.diff_hunk.deleted.hollow_background": "#c15e5510",
        "editor.diff_hunk.deleted.hollow_border": "#c15e554d",
        "search.match_background": "#6578a620",
        "search.active_match_background": "#6578a640",
        "link_text.hover": "#6578a6",

        "panel.background": "#1a1a1f00",
        "panel.focused_border": "#bab39c10",
        "panel.indent_guide": "#bab39c10",
        "panel.indent_guide_hover": "#bab39c20",
        "panel.indent_guide_active": "#bab39c20",
        "panel.overlay_background": "#232328f0",
        "panel.overlay_hover": "#292929",
        "pane.focused_border": "#b7b7b020",
        "pane_group.border": "#bab39c10",
        "tab.active_background": "#1a1a1f0a",
        "tab.inactive_background": "#1a1a1f00",
        "tab_bar.background": "#1a1a1f00",
        "title_bar.background": "#1a1a1ff0",
        "title_bar.inactive_background": "#2e2d33",
        "toolbar.background": "#1a1a1f00",
        "status_bar.background": "#1a1a1ff0",

        "scrollbar.thumb.background": "#bab39c20",
        "scrollbar.thumb.hover_background": "#bab39c30",
        "scrollbar.thumb.active_background": "#bab39c40",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#bab39c10",
        "minimap.thumb.background": "#bab39c20",
        "minimap.thumb.hover_background": "#bab39c30",
        "minimap.thumb.active_background": "#bab39c40",
        "minimap.thumb.border": "#00000000",

