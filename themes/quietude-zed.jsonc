        "terminal.foreground": "#bab39c",
        "terminal.bright_foreground": "#a79879",
        "terminal.dim_foreground": "#bab39c90",
        "terminal.ansi.black": "#282c33",
        "terminal.ansi.red": "#c44e54",
        "terminal.ansi.green": "#718253",
        "terminal.ansi.yellow": "#987242",
        "terminal.ansi.blue": "#5d77bc",
        "terminal.ansi.magenta": "#935fb8",
        "terminal.ansi.cyan": "#578194",
        "terminal.ansi.white": "#a79879",
        "terminal.ansi.bright_black": "#57554f",
        "terminal.ansi.bright_red": "#dc5c62",
        "terminal.ansi.bright_green": "#829460",
        "terminal.ansi.bright_yellow": "#ad834c",
        "terminal.ansi.bright_blue": "#738ac5",
        "terminal.ansi.bright_magenta": "#a375c5",
        "terminal.ansi.bright_cyan": "#6594a9",
        "terminal.ansi.bright_white": "#a79879",
        "terminal.ansi.dim_black": "#282c3390",
        "terminal.ansi.dim_red": "#c44e5490",
        "terminal.ansi.dim_green": "#71825390",
        "terminal.ansi.dim_yellow": "#98724290",
        "terminal.ansi.dim_blue": "#5d77bc90",
        "terminal.ansi.dim_magenta": "#935fb890",
        "terminal.ansi.dim_cyan": "#57819490",
        "terminal.ansi.dim_white": "#a7987990",

        "vim.normal.background": "#00000000",
        "vim.insert.background": "#00000000",
        "vim.replace.background": "#00000000",
        "vim.visual.background": "#00000000",
        "vim.visual_line.background": "#00000000",
        "vim.visual_block.background": "#00000000",
        "vim.yank.background": "#ca9e6630",
        "vim.helix_jump_label.foreground": "#ca9e66",
        "vim.helix_normal.background": "#00000000",
        "vim.helix_select.background": "#00000000",
        "vim.normal.foreground": "#ca9e66",
        "vim.insert.foreground": "#6c765c",
        "vim.replace.foreground": "#c15e55",
        "vim.visual.foreground": "#6578a6",
        "vim.visual_line.foreground": "#6578a6",
        "vim.visual_block.foreground": "#8f73a5",
        "vim.helix_normal.foreground": "#ca9e66",
        "vim.helix_select.foreground": "#6578a6",

        "players": [
          {
            "background": "#b7b7b0",
            "cursor": "#b7b7b0",
            "selection": "#deb17820"
          },
          {
            "background": "#c15e55",
            "cursor": "#c15e55",
            "selection": "#c15e553d"
          },
          {
            "background": "#a79879",
            "cursor": "#a79879",
            "selection": "#a798793d"
          },
          {
            "background": "#8f73a5",
            "cursor": "#8f73a5",
            "selection": "#8f73a53d"
          },
          {
            "background": "#6578a6",
            "cursor": "#6578a6",
            "selection": "#6578a63d"
          },
          {
            "background": "#6c765c",
            "cursor": "#6c765c",
            "selection": "#6c765c3d"
          }
        ],

        "syntax": {
          "primary": { "color": "#bab39c" },
          "title": { "color": "#ca9e66", "font_weight": 700 },
          "keyword": { "color": "#73716b" },
          "keyword.modifier": { "color": "#73716b" },
          "operator": { "color": "#73716b" },
          "function": { "color": "#6c765c" },
          "function.annotation": { "color": "#6c765c" },
          "function.builtin": { "color": "#6c765c" },
          "function.decorator": { "color": "#6c765c" },
          "variable": { "color": "#bab39c" },
          "variable.builtin": { "color": "#bab39c" },
          "variable.parameter": { "color": "#bab39c" },
          "variable.special": { "color": "#bab39c", "font_style": "italic" },
          "constant": { "color": "#bab39c" },
          "constant.builtin": { "color": "#bab39c" },
          "type": { "color": "#ca9e66" },
          "type.builtin": { "color": "#ca9e66" },
          "type.definition": { "color": "#ca9e66" },
          "type.enum.member": { "color": "#bab39c" },
          "type.event": { "color": "#bab39c" },
          "namespace": { "color": "#ca9e66" },
          "attribute": { "color": "#bab39c" },
          "property": { "color": "#bab39c" },
          "number": { "color": "#bab39c" },
          "boolean": { "color": "#bab39c" },
          "string": { "color": "#938f82" },
          "string.doc": { "color": "#938f82" },
          "string.escape": { "color": "#57554f" },
          "string.regex": { "color": "#57554f" },
          "string.regexp": { "color": "#57554f" },
          "string.special": { "color": "#938f82" },
          "string.special.symbol": { "color": "#ca9e66" },
          "comment": { "color": "#565552" },
          "comment.doc": { "color": "#565552" },
          "punctuation": { "color": "#57554f" },
          "punctuation.bracket": { "color": "#57554f" },
          "punctuation.delimiter": { "color": "#57554f" },
          "punctuation.list_marker": { "color": "#57554f" },
          "punctuation.markup": { "color": "#57554f" },
          "punctuation.special": { "color": "#57554f" },
          "tag": { "color": "#ca9e66" },
          "tag.doctype": { "color": "#ca9e66" },
          "constructor": { "color": "#ca9e66" },
          "embedded": { "color": "#bab39c" },
          "enum": { "color": "#ca9e66" },
          "preproc": { "color": "#ca9e66" },
          "label": { "color": "#6578a6" },
          "text.literal": { "color": "#938f82", "font_style": "italic" },
          "variant": { "color": "#bab39c" },
          "selector": { "color": "#ca9e66" },
          "selector.pseudo": { "color": "#73716b" },
          "diff.plus": { "color": "#6c765c" },
          "diff.minus": { "color": "#c15e55" },
          "invalid": { "color": "#c15e55", "font_style": "italic" },
          "emphasis": { "color": "#ca9e66", "font_style": "italic" },
          "emphasis.strong": { "color": "#ca9e66", "font_weight": 700 },
          "link_text": { "color": "#6c765c", "font_style": "normal" },
          "link_uri": { "color": "#73716b" },
          "hint": { "color": "#565552" },
          "predictive": { "color": "#565552", "font_style": "italic" }
        }
